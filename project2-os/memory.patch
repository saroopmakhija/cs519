+void extent_cleanup(struct mm_struct *mm)
+{
+	struct rb_node *node, *next;
+
+	if (mm->extent_count > 0)
+		printk(KERN_INFO "EXTENT comm=%s tgid=%d mm=%px extents=%lu\n",
+			current->comm, current->tgid, mm, mm->extent_count);
+
+	for (node = rb_first(&mm->extent_tree); node; node = next) {
+		struct extent *ext = rb_entry(node, struct extent, rb_node);
+		struct extent_page *ep, *tmp;
+
+		next = rb_next(node);
+
+		list_for_each_entry_safe(ep, tmp, &ext->page_list, list) {
+			list_del(&ep->list);
+			kfree(ep);
+		}
+
+		rb_erase(&ext->rb_node, &mm->extent_tree);
+		kfree(ext);
+	}
+
+	mm->extent_tree = RB_ROOT;
+	mm->extent_count = 0;
+}
+
+static void extent_rb_insert(struct rb_root *root, struct extent *new_ext)
+{
+	struct rb_node **link = &root->rb_node;
+	struct rb_node *parent = NULL;
+
+	while (*link) {
+		struct extent *entry = rb_entry(*link, struct extent, rb_node);
+
+		parent = *link;
+		if (new_ext->start_addr < entry->start_addr)
+			link = &(*link)->rb_left;
+		else
+			link = &(*link)->rb_right;
+	}
+
+	rb_link_node(&new_ext->rb_node, parent, link);
+	rb_insert_color(&new_ext->rb_node, root);
+}
+
+static struct extent *extent_lookup(struct rb_root *root,
+	phys_addr_t phys_addr,
+	struct extent **prev_ext,
+	struct extent **next_ext)
+{
+	struct rb_node *node = root->rb_node;
+	struct extent *prev = NULL;
+	struct extent *next = NULL;
+
+	*prev_ext = NULL;
+	*next_ext = NULL;
+
+	while (node) {
+		struct extent *ext = rb_entry(node, struct extent, rb_node);
+
+		if (phys_addr < ext->start_addr) {
+			next = ext;
+			node = node->rb_left;
+		} else if (phys_addr > ext->end_addr) {
+			prev = ext;
+			node = node->rb_right;
+		} else {
+			return ext;
+		}
+	}
+
+	if (prev && prev->end_addr + PAGE_SIZE == phys_addr)
+		*prev_ext = prev;
+
+	if (next && phys_addr + PAGE_SIZE == next->start_addr)
+		*next_ext = next;
+
+	return NULL;
+}
+
+static void extent_add_page(struct mm_struct *mm, phys_addr_t phys_addr)
+{
+	struct extent *prev_ext = NULL;
+	struct extent *next_ext = NULL;
+	struct extent *cur_ext;
+	struct extent_page *ep;
+	struct extent *new_ext;
+
+	ep = kmalloc(sizeof(*ep), GFP_KERNEL);
+	if (!ep)
+		return;
+
+	new_ext = kmalloc(sizeof(*new_ext), GFP_KERNEL);
+	if (!new_ext) {
+		kfree(ep);
+		return;
+	}
+
+	ep->phys_addr = phys_addr;
+
+	spin_lock(&mm->extent_lock);
+
+	cur_ext = extent_lookup(&mm->extent_tree, phys_addr, &prev_ext, &next_ext);
+
+	if (cur_ext) {
+		spin_unlock(&mm->extent_lock);
+		kfree(ep);
+		kfree(new_ext);
+		return;
+	}
+
+	if (prev_ext && next_ext) {
+		list_add_tail(&ep->list, &prev_ext->page_list);
+		list_splice_tail_init(&next_ext->page_list, &prev_ext->page_list);
+
+		prev_ext->end_addr = next_ext->end_addr;
+		prev_ext->num_pages += next_ext->num_pages + 1;
+
+		rb_erase(&next_ext->rb_node, &mm->extent_tree);
+		kfree(next_ext);
+		mm->extent_count--;
+
+		spin_unlock(&mm->extent_lock);
+		kfree(new_ext);
+		return;
+	}
+
+	if (prev_ext) {
+		list_add_tail(&ep->list, &prev_ext->page_list);
+		prev_ext->end_addr = phys_addr;
+		prev_ext->num_pages++;
+
+		spin_unlock(&mm->extent_lock);
+		kfree(new_ext);
+		return;
+	}
+
+	if (next_ext) {
+		rb_erase(&next_ext->rb_node, &mm->extent_tree);
+
+		list_add(&ep->list, &next_ext->page_list);
+		next_ext->start_addr = phys_addr;
+		next_ext->num_pages++;
+
+		extent_rb_insert(&mm->extent_tree, next_ext);
+
+		spin_unlock(&mm->extent_lock);
+		kfree(new_ext);
+		return;
+	}
+
+	new_ext->start_addr = phys_addr;
+	new_ext->end_addr = phys_addr;
+	new_ext->num_pages = 1;
+	new_ext->extent_id = mm->next_extent_id++;
+	INIT_LIST_HEAD(&new_ext->page_list);
+	list_add(&ep->list, &new_ext->page_list);
+
+	extent_rb_insert(&mm->extent_tree, new_ext);
+	mm->extent_count++;
+
+	spin_unlock(&mm->extent_lock);
+}
