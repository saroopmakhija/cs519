+	/*
+     * Cooperative scheduling:
+     * If normal CFS picked an inactive task, try to run the active
+     * runnable task with the smallest vruntime instead. However, do not
+     * starve inactive tasks forever. If the inactive task is too far behind in vruntime, let it run.
+    */
+	if (se && coop_entity_inactive(se)) {
+        struct sched_entity *active;
+
+        active = pick_first_active_entity(cfs_rq, curr);
 
+        if (active) {
+            s64 vdiff = active->vruntime - se->vruntime;
+
+            if (vdiff <= COOP_STARVE_GRAN_NS)
+                se = active;
+        }
+	}
