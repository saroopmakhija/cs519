+static inline bool coop_entity_inactive(struct sched_entity *se)
+{
+#ifdef CONFIG_FAIR_GROUP_SCHED
+	if (!entity_is_task(se))
+		return false;
+#endif
+
+	return task_of(se)->coop_inactive;
+}
+
+static struct sched_entity *
+pick_first_active_entity(struct cfs_rq *cfs_rq, struct sched_entity *curr)
+{
+    struct sched_entity *se = __pick_first_entity(cfs_rq);
+    struct sched_entity *best = NULL;
+
+    while (se) {
+        if (!coop_entity_inactive(se)) {
+            best = se;
+            break;
+        }
+
+        se = __pick_next_entity(se);
+    }
+
+    if (curr && !coop_entity_inactive(curr)) {
+        if (!best || entity_before(curr, best))
+            best = curr;
+    }
+
+    return best;
+}
